{
  "name": "one-data-confluence-test",
  "version": "1.2.0-multisource.1",
  "private": true,
  "description": "One Data desktop app",
  "main": "main.cjs",
  "scripts": {
    "prepare:bundle": "npm --prefix ../frontend run build && mvn -f ../backend/pom.xml -Pdesktop -DskipTests package && node scripts/prepare-runtime.mjs",
    "start": "npm run prepare:bundle && electron .",
    "dist:win": "npm run prepare:bundle && electron-builder --win nsis",
    "dist:mac": "npm run prepare:bundle && electron-builder --mac dmg zip",
    "pack": "npm run prepare:bundle && electron-builder --dir",
    "test": "node --test tests/*.test.cjs",
    "pack:variants": "npm run prepare:bundle && node scripts/build-variants.mjs"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.onedata.confluencetest",
    "productName": "One Data Confluence Test",
    "asar": true,
    "directories": {
      "output": "release-multisource1"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "confluence*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/one-data.jar",
        "to": "one-data.jar"
      },
      {
        "from": "build/runtime",
        "to": "runtime"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity"
    }
  },
  "dependencies": {
    "parse5": "7.3.0"
  },
  "startupMode": "manual"
}
